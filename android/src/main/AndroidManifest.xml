<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!-- Hands the AssetManager of the app to the native library of the
         sampler before any Dart code runs, so that "apk:/" paths read the
         assets of the APK (ticket 27). -->
    <provider
      android:name="com.audanika.aud_dsp_sampler.AudDspSamplerAssets"
      android:authorities="${applicationId}.aud_dsp_sampler"
      android:exported="false"
      android:initOrder="100" />
  </application>
</manifest>
